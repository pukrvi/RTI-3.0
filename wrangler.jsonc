{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rti-sahayak",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Draft storage for an in-progress request.
  // Create once with:  npx wrangler kv namespace create DRAFTS
  // then paste the returned id below. Without it the app falls back to
  // in-memory storage, which is fine for local dev.
  "kv_namespaces": [
    { "binding": "DRAFTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
